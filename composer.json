{
    "name": "edoctor/talkmed-meeting-open-sdk",
    "description": "talkMed meeting open api sdk",
    "keywords": ["talkmed", "meeting", "open-api", "sdk"],
    "require": {
        "php": "^7.2.5 || ^8.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "mockery/mockery": "^1.3"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "于紫辉",
            "email": "1197422754@qq.com"
        },
        {
            "name": "胡修航",
            "email": "1249828882@qq.com"
        },
        {
            "name": "代甫勇",
            "email": "augdai@163.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "eDoctor\\Meeting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "eDoctor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
